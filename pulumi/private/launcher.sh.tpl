#!/usr/bin/env bash
# Generated by rules_pulumi for @@LABEL@@: runs the Pulumi CLI on stack @@STACK_DISPLAY@@.
#
# Written for bash 3.2, the version macOS ships: no associative arrays, and no
# ${var//pat/rep} with a quote in the pattern written as \' (3.2 keeps the
# backslash) or a path as the replacement (bash 5.2 reads & in it).
set -euo pipefail

_die() {
    echo "rules_pulumi: $*" >&2
    exit 1
}

# Values from the BUILD file, each a single-quoted shell word.
_label=@@LABEL_Q@@
_stack=@@STACK_Q@@
_has_project=@@HAS_PROJECT@@
_pulumi_rel=@@PULUMI_Q@@
_template_rel=@@TEMPLATE_Q@@
_config_dir_rel=@@CONFIG_DIR_Q@@
_stack_config_dir_rel=@@STACK_CONFIG_DIR_Q@@
_stack_file=@@STACK_FILE_Q@@
_backend=@@BACKEND_Q@@
_outputs_rel=@@OUTPUTS_PATH_Q@@
_outputs_label=@@OUTPUTS_LABEL_Q@@
_outputs_template_rel=@@OUTPUTS_TEMPLATE_Q@@
_outputs_only=@@OUTPUTS_ONLY@@

# --- Runfiles -----------------------------------------------------------------
# $0.runfiles first: RUNFILES_DIR may be inherited from an unrelated process.
if [[ -d "$0.runfiles" ]]; then
    _r="$0.runfiles"
elif [[ -n "${RUNFILES_DIR:-}" && -d "${RUNFILES_DIR}" ]]; then
    _r="$RUNFILES_DIR"
else
    _die "cannot find the runfiles of $0; run it with bazel run"
fi
_r="$(cd "$_r" && pwd)"
_pulumi="$_r/$_pulumi_rel"
[[ -x "$_pulumi" ]] || _die "missing from runfiles: $_pulumi"

# --- Source tree ----------------------------------------------------------------
# Stack configuration and the outputs file live in the source tree, so the run
# must know where the workspace is.
[[ -n "${BUILD_WORKSPACE_DIRECTORY:-}" ]] ||
    _die "BUILD_WORKSPACE_DIRECTORY is not set: run this with bazel run, so stack configuration lands in the source tree"

# --- Project directory ----------------------------------------------------------
# One directory per workspace and target, at a stable path: Pulumi keeps
# per-project state keyed by this path, so a fresh directory per run would leave
# a new entry behind every time. A stack reference has no project, and its
# directory stays empty.
_key="$(printf '%s\n%s\n' "$BUILD_WORKSPACE_DIRECTORY" "$_label" | cksum | awk '{print $1}')"
_work="${XDG_CACHE_HOME:-$HOME/.cache}/rules_pulumi/@@WORK_NAME@@-$_key"
mkdir -p "$_work"

if [[ "$_has_project" == true ]]; then
    _template="$_r/$_template_rel"
    [[ -f "$_template" ]] || _die "missing from runfiles: $_template"
    _config_dir="$BUILD_WORKSPACE_DIRECTORY/$_config_dir_rel"
    # The project file's stackConfigDir, if it has one, read when it was built.
    _scd="$(cat "$_r/$_stack_config_dir_rel")"
    [[ -z "$_scd" ]] || _config_dir="$_config_dir/$_scd"
    [[ -d "$_config_dir" ]] || _die "no such directory in the workspace: $_config_dir"

    # The project file, with the runfiles root put in as a YAML single-quoted
    # string. Replaced piecewise so no character of the path is special.
    _q="'"
    _root="${_r//$_q/$_q$_q}"
    _rest="$(cat "$_template")"
    _yaml=""
    while [[ "$_rest" == *@@RUNFILES@@* ]]; do
        _yaml+="${_rest%%@@RUNFILES@@*}$_root"
        _rest="${_rest#*@@RUNFILES@@}"
    done
    _yaml+="$_rest"
    printf '%s\n' "$_yaml" >"$_work/Pulumi.yaml.$$"
    mv -f "$_work/Pulumi.yaml.$$" "$_work/Pulumi.yaml"

    # The stack's configuration is the source tree's file, through a symlink:
    # every command, stack init included, then reads and writes the checked-in
    # file.
    ln -sfn "$_config_dir/Pulumi.$_stack_file.yaml" "$_work/Pulumi.$_stack_file.yaml"
fi

# --- Pulumi home ------------------------------------------------------------------
# Pulumi loads any plugin it finds in $PULUMI_HOME/plugins, whatever the
# project pins, and has no setting for that directory alone. So each target
# gets a Pulumi home of its own, with no plugins, sharing only the user's login
# credentials.
_user_home="${PULUMI_HOME:-$HOME/.pulumi}"
_home="$_work.pulumi-home"
rm -rf "$_home/plugins"
mkdir -p "$_home"
if [[ -e "$_user_home/credentials.json" ]]; then
    ln -sfn "$_user_home/credentials.json" "$_home/credentials.json"
fi

# --- Environment ------------------------------------------------------------------
# Precedence, lowest first: env, then env_cmds output in order, then whatever
# the calling shell already exports. Names starting with _ are the launcher's.
_orig_env=$'\n'"$(compgen -e)"$'\n'
_default() {
    [[ "$1" != _* ]] || _die "environment variable names starting with _ are reserved: $1"
    [[ "$_orig_env" == *$'\n'"$1"$'\n'* ]] || export "$1=$2"
}
@@ENV_DEFAULTS@@
@@ENV_CMDS@@
for _cmd in ${_env_cmds[@]+"${_env_cmds[@]}"}; do
    _out="$(cd "$BUILD_WORKSPACE_DIRECTORY" && bash -c "$_cmd")" ||
        _die "env_cmds: a command exited with status $?: $_cmd"
    while IFS= read -r _line; do
        [[ -z "$_line" || "$_line" == \#* ]] && continue
        # Never echo the line: it may hold a secret.
        [[ "$_line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] ||
            _die "env_cmds: a command printed a line that is not KEY=VALUE: $_cmd"
        _default "${_line%%=*}" "${_line#*=}"
    done <<<"$_out"
done

# Fixed, whatever the shell says: the target is the stack (and its backend,
# when the BUILD file names one), and plugins come only from the providers
# Bazel pinned.
export PULUMI_STACK="$_stack"
if [[ -n "$_backend" ]]; then
    export PULUMI_BACKEND_URL="$_backend"
fi
export PULUMI_HOME="$_home"
export PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION=true
export PULUMI_IGNORE_AMBIENT_PLUGINS=true
# A program that uses a runfiles library must find this run's runfiles.
export RUNFILES_DIR="$_r"
unset RUNFILES_MANIFEST_FILE RUNFILES_MANIFEST_ONLY

# --- Outputs file ---------------------------------------------------------------
# The stack's outputs as a .bzl file in the source tree, so BUILD files can use
# them without asking Pulumi. Secret outputs are printed by Pulumi as
# "[secret]", never as their values, and the file keeps only that placeholder.

# _outputs write|check [JSON]: JSON, when given, replaces the stack's outputs.
_outputs() {
    local json body rest target tmp
    if [[ $# -ge 2 ]]; then
        json="$2"
    else
        json="$("$_pulumi" --cwd "$_work" stack output --json)" ||
            _die "could not read the outputs of the stack"
    fi
    [[ "$json" != *"'''"* ]] || _die "the stack's outputs contain ''', which the outputs file cannot hold"
    rest="$(cat "$_r/$_outputs_template_rel")"
    body="${rest%%@@OUTPUTS_JSON@@*}$json${rest#*@@OUTPUTS_JSON@@}"
    target="$BUILD_WORKSPACE_DIRECTORY/$_outputs_rel"
    if [[ "$1" == check ]]; then
        if [[ -f "$target" ]] && [[ "$(cat "$target")" == "$body" ]]; then
            echo "rules_pulumi: $_outputs_rel is up to date" >&2
            return 0
        fi
        echo "rules_pulumi: $_outputs_rel does not match the stack's outputs; run: bazel run $_outputs_label" >&2
        return 1
    fi
    if [[ -f "$target" ]] && [[ "$(cat "$target")" == "$body" ]]; then
        return 0
    fi
    tmp="$target.$$"
    printf '%s\n' "$body" >"$tmp"
    mv -f "$tmp" "$target"
    echo "rules_pulumi: wrote $_outputs_rel" >&2
}

if [[ "$_outputs_only" == true ]]; then
    case "$#:${1:-}" in
        0:) _outputs write ;;
        1:--check) _outputs check ;;
        *) _die "usage: bazel run $_label [-- --check]" ;;
    esac
    exit
fi

# The command is the first argument that is neither a flag nor the value of a
# global flag that takes one. Outputs change only when resources do: after up
# and destroy, under any of their names, and not when only help was asked for.
_command=""
_help=false
_skip_next=false
for _a in "$@"; do
    case "$_a" in
        -h | --help) _help=true ;;
    esac
    if [[ "$_skip_next" == true ]]; then
        _skip_next=false
        continue
    fi
    case "$_a" in
        --color | --verbose | -v | --tracing | --profiling | --otel-traces | --memprofilerate | --cwd | -C)
            _skip_next=true
            continue
            ;;
        -*) continue ;;
    esac
    [[ -n "$_command" ]] || _command="$_a"
done
case "$_command" in
    up | update) _changes=up ;;
    destroy | down | dn) _changes=destroy ;;
    *) _changes="" ;;
esac
if [[ -n "$_outputs_rel" && -n "$_changes" && "$_help" == false ]]; then
    _rc=0
    "$_pulumi" --cwd "$_work" "$@" || _rc=$?
    if [[ $_rc -eq 0 ]]; then
        if [[ "$_changes" == destroy ]] && ! "$_pulumi" --cwd "$_work" stack output --json >/dev/null 2>&1; then
            # destroy --remove deletes the stack itself: it has no outputs left.
            _outputs write '{}'
        else
            _outputs write
        fi
    fi
    exit "$_rc"
fi

exec "$_pulumi" --cwd "$_work" "$@"
