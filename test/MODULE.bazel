module(name = "rules_pulumi_integration_test")

bazel_dep(name = "rules_pulumi", version = "0.0.0")
local_path_override(
    module_name = "rules_pulumi",
    path = "../",
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.27.2",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_default_attributes(
    directives = [
        # The SDKs ship their generated .pb.go files; generating proto rules
        # for them only adds a protoc build from source.
        "gazelle:proto disable",
    ],
)
use_repo(
    go_deps,
    "com_github_pulumi_pulumi_random_sdk_v4",
    "com_github_pulumi_pulumi_sdk_v3",
)

pulumi = use_extension("@rules_pulumi//pulumi:extensions.bzl", "pulumi")
# The digests are pinned rather than looked up, so the tests never depend on
# GitHub's releases API, which limits unauthenticated calls.
pulumi.provider(
    name = "random",
    sha256s = {
        "darwin-arm64": "f2228a848abed33e3cdd9eb14d501a2861525cfbcc81ccefd371ae642784b456",
        "darwin-x64": "6c352166709f3539475ce61a098b0b7f152f40f830eae21fe895fd7ab3ada191",
        "linux-arm64": "ca8f2f5cb0a9e162be0fa559b90b3e35c9283df763e27c49ea78638b633984bd",
        "linux-x64": "d23098a615cd8590e026ec3d36c95f00617d93b0af14164162b81cf1af808174",
    },
    version = "4.21.6",
)
use_repo(pulumi, "pulumi_provider_random")
