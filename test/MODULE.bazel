module(name = "rules_pulumi_integration_test")

bazel_dep(name = "rules_pulumi", version = "0.0.0")
local_path_override(
    module_name = "rules_pulumi",
    path = "../",
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.27.2",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.gazelle_default_attributes(
    directives = [
        # The SDKs ship their generated .pb.go files; generating proto rules
        # for them only adds a protoc build from source.
        "gazelle:proto disable",
    ],
)
use_repo(
    go_deps,
    "com_github_pulumi_pulumi_random_sdk_v4",
    "com_github_pulumi_pulumi_sdk_v3",
)

pulumi = use_extension("@rules_pulumi//pulumi:extensions.bzl", "pulumi")
pulumi.provider(
    name = "random",
    version = "4.21.6",
)
use_repo(pulumi, "pulumi_provider_random")
