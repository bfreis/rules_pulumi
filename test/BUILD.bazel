load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:write_text.bzl", "write_text")
load("//program:fixture_outputs.bzl", "OUTPUTS", "SECRET_OUTPUTS")

# Each test runs a stack launcher the way bazel run would, against a workspace
# and a file:// backend inside its own temporary directory.

_GO = "@go_sdk//:bin/go"

sh_test(
    name = "test_up",
    srcs = ["test_up.sh"],
    data = [
        "testlib.sh",
        "//program:dev",
        _GO,
    ],
    env = {
        "GO_BIN": "$(rootpath %s)" % _GO,
        "STACK": "$(rootpath //program:dev)",
    },
)

sh_test(
    name = "test_no_providers",
    srcs = ["test_no_providers.sh"],
    data = [
        "testlib.sh",
        "//program:dev_no_providers",
        "@pulumi_provider_random",
        _GO,
    ],
    env = {
        "CACHED_PLUGIN": "$(rootpath @pulumi_provider_random)",
        "GO_BIN": "$(rootpath %s)" % _GO,
        "STACK": "$(rootpath //program:dev_no_providers)",
    },
)

sh_test(
    name = "test_requires_bazel_run",
    srcs = ["test_requires_bazel_run.sh"],
    data = [
        "testlib.sh",
        "//program:dev",
        _GO,
    ],
    env = {
        "GO_BIN": "$(rootpath %s)" % _GO,
        "STACK": "$(rootpath //program:dev)",
    },
)

sh_test(
    name = "test_env_cmds_errors",
    srcs = ["test_env_cmds_errors.sh"],
    data = [
        "testlib.sh",
        "//program:dev_bad_env_cmd",
        "//program:dev_failing_env_cmd",
        "//program:dev_reserved_env_cmd",
        _GO,
    ],
    env = {
        "BAD_LINE_STACK": "$(rootpath //program:dev_bad_env_cmd)",
        "FAILING_STACK": "$(rootpath //program:dev_failing_env_cmd)",
        "RESERVED_STACK": "$(rootpath //program:dev_reserved_env_cmd)",
        "GO_BIN": "$(rootpath %s)" % _GO,
