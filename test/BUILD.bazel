sh_test(
    name = "test_outputs",
    srcs = ["test_outputs.sh"],
    data = [
        "testlib.sh",
        "//program:dev",
        "//program:dev.outputs",
        "//program:fixture_outputs.bzl",
        _GO,
    ],
    env = {
        "FIXTURE": "$(rootpath //program:fixture_outputs.bzl)",
        "GO_BIN": "$(rootpath %s)" % _GO,
        "OUTPUTS": "$(rootpath //program:dev.outputs)",
        "STACK": "$(rootpath //program:dev)",
    },
)

# What a BUILD file sees when it loads an outputs file.
write_text(
    name = "loaded_outputs",
    content = json.encode({
        "OUTPUTS": OUTPUTS,
        "SECRET_OUTPUTS": SECRET_OUTPUTS,
    }),
)

sh_test(
    name = "test_outputs_load",
    srcs = ["test_outputs_load.sh"],
    data = [":loaded_outputs"],
    env = {"LOADED": "$(rootpath :loaded_outputs)"},
)

